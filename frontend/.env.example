# Adresses du backend (API de questions-reponses), jointes cote serveur par
# les routes src/app/api/*. Exemple en local : http://127.0.0.1:8000/chat
BACKEND_CHAT_URL=
BACKEND_FEEDBACK_URL=
BACKEND_SESSIONS_URL=

# Client du backend interroge par ce deploiement (jamais choisi par le navigateur).
CHATBOT_CLIENT=

# Acces par identifiant et mot de passe (src/proxy.ts). AUTH_SECRET signe le
# cookie de session : longue chaine aleatoire (openssl rand -hex 32).
AUTH_USER=
AUTH_PASSWORD=
AUTH_SECRET=
